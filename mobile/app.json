{
  "expo": {
    "name": "Abhyas Tracker - UPSC & MPSC",
    "slug": "abhyas-tracker",
    "scheme": "abhyas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aparaitech.abhyastracker",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#247C78"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "ACCESS_NETWORK_STATE"
      ],
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://mpsc-upsc-study-hours.onrender.com/api",
      "eas": {
        "projectId": "dce9cc9e-4da0-4062-bfe7-3bab08bd860b"
      }
    }
  }
}
