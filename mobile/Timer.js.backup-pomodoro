
import React from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  StyleSheet,
  Alert,
} from 'react-native';

const COLORS = {
  bg: '#F7F9FE',
  white: '#FFFFFF',
  ink: '#142841',
  muted: '#72849F',
  blue: '#37689F',
  soft: '#E9F0FC',
  line: '#E8EEF8',
};

export default function Timer({
  elapsed = 0,
  running = false,
  mode = 'Pomodoro',
  setMode,
  startSession,
  pauseSession,
  finish,
  resetSession,
  saving = false,
  selected = '',
  subjects = [],
  setSelected,
}) {
  const formatTime = (totalSeconds) => {
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;

    return `${String(minutes).padStart(2, '0')}:${String(
      seconds
    ).padStart(2, '0')}`;
  };

  const changeMode = (nextMode) => {
    if (running || elapsed > 0 || saving) {
      Alert.alert(
        'Session in progress',
        'Finish or reset the current session before changing timer mode.'
      );
      return;
    }

    setMode?.(nextMode);
  };

  return (
    <View style={styles.container}>
      <Text style={styles.heading}>Study Timer</Text>
      <Text style={styles.subtitle}>
        Track your study sessions and stay consistent.
      </Text>

      <View style={styles.modeRow}>
        {['Pomodoro', 'Stopwatch', 'Custom'].map((item) => (
          <TouchableOpacity
            key={item}
            style={[
              styles.modeButton,
              mode === item && styles.activeMode,
            ]}
            onPress={() => changeMode(item)}
          >
            <Text
              style={[
                styles.modeText,
                mode === item && styles.activeModeText,
              ]}
            >
              {item}
            </Text>
          </TouchableOpacity>
        ))}
      </View>

      <View style={styles.card}>
        <Text style={styles.label}>STUDY SUBJECT</Text>

        {subjects.length > 0 ? (
          <View style={styles.subjectList}>
            {subjects.map((subject) => {
              const id = subject.id ?? subject._id;
              const name =
                subject.name ?? subject.title ?? 'Subject';

              return (
                <TouchableOpacity
                  key={String(id ?? name)}
                  style={[
                    styles.subjectButton,
                    selected === id && styles.selectedSubject,
                  ]}
                  disabled={!setSelected || running || elapsed > 0 || saving}
                  onPress={() => setSelected?.(id)}
                >
                  <Text style={styles.subjectText}>{name}</Text>
                </TouchableOpacity>
              );
            })}
          </View>
        ) : (
          <Text style={styles.subtitle}>
            Your subjects will appear here when loaded.
          </Text>
        )}

        <View style={styles.timerCircle}>
          <Text style={styles.timerLabel}>STUDY TIME</Text>
          <Text style={styles.time}>{formatTime(elapsed)}</Text>
          <Text style={styles.status}>
            {saving
              ? 'Saving session...'
              : running
              ? 'Session in progress'
              : elapsed > 0
              ? 'Session paused'
              : 'Ready to focus'}
          </Text>
        </View>

        <TouchableOpacity
          style={[styles.primaryButton, saving && styles.disabledButton]}
          disabled={saving}
          onPress={running ? pauseSession : startSession}
        >
          <Text style={styles.primaryText}>
            {saving
              ? 'Saving...'
              : running
              ? 'Pause Session'
              : elapsed > 0
              ? 'Resume Session'
              : 'Start Session'}
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.secondaryButton}
          disabled={saving}
          onPress={finish}
        >
          <Text style={styles.secondaryText}>Finish & Save Session</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.resetButton}
          disabled={saving}
          onPress={resetSession}
        >
          <Text style={styles.resetText}>Reset Timer</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
}

