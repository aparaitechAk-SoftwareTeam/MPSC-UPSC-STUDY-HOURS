import React,{useEffect,useState} from 'react';import{createRoot}from'react-dom/client';import{BookOpen,Users,Clock,BarChart3,Bell,Plus,Trash2,LogOut}from'lucide-react';import './style.css';
const API=import.meta.env.VITE_API_URL||'http://localhost:4000/api';function App(){const[token,setToken]=useState(localStorage.getItem('abhyas_admin_token')||'');const[tab,setTab]=useState('Dashboard');const[error,setError]=useState('');const[data,setData]=useState({});const[form,setForm]=useState({name:'',paper:'GS Paper II',topics:40,title:'',message:''});const[email,setEmail]=useState('admin@abhyas.local'),[password,setPassword]=useState('');async function request(url,method='GET',body){let r=await fetch(API+url,{method,headers:{'Content-Type':'application/json',Authorization:'Bearer '+token},body:body?JSON.stringify(body):undefined});let j=await r.json();if(!r.ok)throw new Error(j.error||'Request failed');return j}async function load(){try{setError('');const [overview,users,subjects]=await Promise.all(['/admin/overview','/admin/users','/admin/subjects'].map(p=>request(p)));setData({overview,users,subjects})}catch(e){setError(e.message)}}useEffect(()=>{if(token)load()},[token]);async function login(e){e.preventDefault();try{setError('');let r=await fetch(API+'/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});let d=await r.json();if(!r.ok)throw new Error(d.error);if(d.user.role!=='admin')throw new Error('Admin account required');localStorage.setItem('abhyas_admin_token',d.token);setToken(d.token)}catch(e){setError(e.message)}}async function addSubject(e){e.preventDefault();try{await request('/admin/subjects','POST',{name:form.name,paper:form.paper,topics:Number(form.topics)});setForm({...form,name:''});await load()}catch(e){setError(e.message)}}async function alert(e){e.preventDefault();try{await request('/admin/notifications','POST',{title:form.title,message:form.message});setForm({...form,title:'',message:''});window.alert('Notification sent')}catch(e){setError(e.message)}}async function del(id){if(!confirm('Delete this subject?'))return;try{await request('/admin/subjects/'+id,'DELETE');load()}catch(e){setError(e.message)}}const links=[['Dashboard',BarChart3],['Students',Users],['Syllabus',BookOpen],['Notifications',Bell]];if(!token)return <div className="login"><form onSubmit={login} className="panel"><h1>📘 Abhyas Tracker</h1><p>Admin Control Panel</p><label>Email</label><input value={email} onChange={e=>setEmail(e.target.value)} type="email" required/><label>Password</label><input value={password} onChange={e=>setPassword(e.target.value)} type="password" required/><button>Sign In</button>{error&&<p className="error">{error}</p>}</form></div>;return <div className="shell"><aside><h2>📘 Abhyas Tracker</h2><p>ADMIN WORKSPACE</p>{links.map(([name,Icon])=><button className={tab===name?'active':''} key={name} onClick={()=>setTab(name)}><Icon size={18}/>{name}</button>)}<button className="exit" onClick={()=>{localStorage.removeItem('abhyas_admin_token');setToken('')}}><LogOut size={18}/>Sign Out</button></aside><main><header><div><small>Management / {tab}</small><h1>{tab}</h1></div><span className="pill">Admin • Online</span></header>{error&&<p className="error">{error}</p>}{tab==='Dashboard'&&<><div className="metrics">{[['Students',data.overview?.users,Users],['Subjects',data.overview?.subjects,BookOpen],['Focus Sessions',data.overview?.sessions,Clock],['Study Hours',((data.overview?.minutes||0)/60).toFixed(1),BarChart3]].map(([label,value,Icon])=><div className="panel metric" key={label}><Icon/><p>{label}</p><h2>{value??'–'}</h2></div>)}</div><section className="panel"><h2>Platform Overview</h2><p>Manage students, exam subjects, and announcements from this panel.</p><div className="bar"><div style={{width:'72%'}}/></div></section></>}{tab==='Students'&&<section className="panel"><h2>Registered Accounts</h2><table><thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead><tbody>{data.users?.map(u=><tr key={u.id}><td>{u.name}</td><td>{u.email}</td><td><span className="pill">{u.role}</span></td></tr>)}</tbody></table></section>}{tab==='Syllabus'&&<div className="twocol"><section className="panel"><h2>Subjects & Syllabus</h2>{data.subjects?.map(s=><div className="subject" key={s.id}><div><b>{s.name}</b><p>{s.paper} • {s.completed}/{s.topics} topics</p></div><button className="iconbtn" onClick={()=>del(s.id)} title="Delete"><Trash2 size={16}/></button></div>)}</section><form className="panel" onSubmit={addSubject}><h2>Add New Subject</h2><label>Subject</label><input value={form.name} onChange={e=>setForm({...form,name:e.target.value})} required/><label>Paper</label><input value={form.paper} onChange={e=>setForm({...form,paper:e.target.value})}/><label>Total Topics</label><input type="number" min="1" value={form.topics} onChange={e=>setForm({...form,topics:e.target.value})}/><button><Plus size={16}/>Add Subject</button></form></div>}{tab==='Notifications'&&<form className="panel narrow" onSubmit={alert}><h2>Broadcast Announcement</h2><label>Title</label><input value={form.title} onChange={e=>setForm({...form,title:e.target.value})} required/><label>Message</label><textarea rows="5" value={form.message} onChange={e=>setForm({...form,message:e.target.value})} required/><button><Bell size={16}/>Send to Students</button></form>}</main></div>}createRoot(document.getElementById('root')).render(<App/>);
